          },
          "city": {
            "title": "City",
            "type": "string"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "district": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "District"
          },
          "is_verified": {
            "title": "Is Verified",
            "type": "boolean"
          },
          "line1": {
            "title": "Line1",
            "type": "string"
          },
          "line2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line2"
          },
          "pincode": {
            "title": "Pincode",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "state_code": {
            "title": "State Code",
            "type": "string"
          },
          "valid_from": {
            "format": "date",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          }
        },
        "required": [
          "address_id",
          "address_type",
          "line1",
          "line2",
          "city",
          "district",
          "state",
          "state_code",
          "pincode",
          "country",
          "is_verified",
          "valid_from",
          "valid_to"
        ],
        "title": "Address",
        "type": "object"
      },
      "AddressType": {
        "enum": [
          "permanent",
          "correspondence"
        ],
        "title": "AddressType",
        "type": "string"
      },
      "CustomerProfile": {
        "properties": {
          "addresses": {
            "items": {
              "$ref": "#/components/schemas/Address"
            },
            "title": "Addresses",
            "type": "array"
          },
          "annual_income_band": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IncomeBand"
              },
              {
                "type": "null"
              }
            ]
          },
          "cif_number": {
            "title": "Cif Number",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "date_of_birth": {
            "format": "date",
            "title": "Date Of Birth",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "employer_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Employer Name"
          },
          "first_name": {
            "title": "First Name",
            "type": "string"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "last_name": {
            "title": "Last Name",
            "type": "string"
          },
          "middle_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Middle Name"
          },
          "mobile": {
            "title": "Mobile",
            "type": "string"
          },
          "mobile_verified": {
            "title": "Mobile Verified",
            "type": "boolean"
          },
          "occupation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occupation"
          },
          "onboarding_channel": {
            "$ref": "#/components/schemas/OnboardingChannel"
          },
          "persona": {
            "$ref": "#/components/schemas/Persona"
          },
          "preferred_language": {
            "title": "Preferred Language",
            "type": "string"
          },
          "relationship_start_date": {
            "format": "date",
            "title": "Relationship Start Date",
            "type": "string"
          },
          "residential_status": {
            "$ref": "#/components/schemas/ResidentialStatus"
          },
          "risk_category": {
            "$ref": "#/components/schemas/RiskCategory"
          },
          "segment": {
            "$ref": "#/components/schemas/Segment"
          },
          "status": {
            "$ref": "#/components/schemas/CustomerStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "customer_id",
          "cif_number",
          "first_name",
          "middle_name",
          "last_name",
          "date_of_birth",
          "gender",
          "email",
          "mobile",
          "mobile_verified",
          "persona",
          "occupation",
          "employer_name",
          "annual_income_band",
          "segment",
          "residential_status",
          "preferred_language",
          "onboarding_channel",
          "relationship_start_date",
          "status",
          "risk_category",
          "created_at",
          "updated_at",
          "addresses"
        ],
        "title": "CustomerProfile",
        "type": "object"
      },
      "CustomerSearchResult": {
        "properties": {
          "customers": {
            "items": {
              "$ref": "#/components/schemas/CustomerSummary"
            },
            "title": "Customers",
            "type": "array"
          }
        },
        "required": [
          "customers"
        ],
        "title": "CustomerSearchResult",
        "type": "object"
      },
      "CustomerStatus": {
        "description": "A Customer's standing with the bank; Account and KYC statuses are separate lifecycles.",
        "enum": [
          "prospect",
          "active",
          "on_hold",
          "dormant",
          "frozen",
          "under_investigation",
          "deceased_claim_pending",
          "closed"
        ],
        "title": "CustomerStatus",
        "type": "string"
      },
      "CustomerSummary": {
        "description": "One search hit: enough to tell Customers apart and pick one.",
        "properties": {
          "cif_number": {
            "title": "Cif Number",
            "type": "string"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "mobile": {
            "title": "Mobile",
            "type": "string"
          },
          "segment": {
            "$ref": "#/components/schemas/Segment"
          },
          "status": {
            "$ref": "#/components/schemas/CustomerStatus"
          }
        },
        "required": [
          "customer_id",
          "cif_number",
          "full_name",
          "mobile",
          "segment",
          "status"
        ],
        "title": "CustomerSummary",
        "type": "object"
      },
      "Gender": {
        "description": "Gender as recorded on Indian KYC documents.",
        "enum": [
          "female",
          "male",
          "transgender"
        ],
        "title": "Gender",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "description": "Probe response; `status` is the only field orchestrators read.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "IncomeBand": {
        "description": "Declared annual income, in the lakh bands Indian onboarding forms use.",
        "enum": [
          "up_to_3_lakh",
          "3_to_6_lakh",
          "6_to_12_lakh",
          "12_to_25_lakh",
          "25_to_50_lakh",
          "above_50_lakh"
        ],
        "title": "IncomeBand",
        "type": "string"
      },
      "OnboardingChannel": {
        "description": "Where a Customer's relationship began.",
        "enum": [
          "app",
          "web",
          "assisted",
          "partner"
        ],
        "title": "OnboardingChannel",
        "type": "string"
      },
      "Persona": {
        "description": "The behavioural archetype a Customer belongs to (see GLOSSARY: Persona).",
        "enum": [
          "salaried",
          "student",
          "gig_worker",
          "sme_owner",
          "nri",
          "senior_citizen"
        ],
        "title": "Persona",
        "type": "string"
      },
      "Readiness": {
        "properties": {
          "schema_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Revision"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "schema_revision"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "ResidentialStatus": {
        "enum": [
          "resident",
          "nri"
        ],
        "title": "ResidentialStatus",
        "type": "string"
      },
      "RiskCategory": {
        "description": "KYC risk category; it sets the Re-KYC interval (see GLOSSARY: Risk category).",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "RiskCategory",
        "type": "string"
      },
      "Segment": {
        "description": "The commercial tier a Customer is served in (see GLOSSARY: Segment).",
        "enum": [
          "mass",
          "affluent",
          "premium"
        ],
        "title": "Segment",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "GatewaySignature": {
        "description": "`v1=` and a hex HMAC-SHA256 by the gateway over the method, target, body, `X-Kosha-Timestamp`, `X-Kosha-Actor` and `X-Kosha-Kb-Ceiling` headers (ADR 0013).",
        "in": "header",
        "name": "X-Kosha-Signature",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Kosha Core Banking API"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "The process is up and serving requests. It never touches the database.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "The database answers and is migrated to exactly the revision this build expects.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Not ready; retry shortly"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/customers": {
      "get": {
        "description": "Customers matching every criterion given, in name order.",
        "operationId": "search_customers_v1_customers_get",
        "parameters": [
          {
            "description": "Part of the first and last name.",
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "minLength": 2,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Part of the first and last name.",
              "title": "Name"
            }
          },
          {
            "in": "query",
            "name": "cif_number",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{10}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cif Number"
            }
          },
          {
            "in": "query",
            "name": "mobile_last4",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mobile Last4"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerSearchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid argument"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Database unavailable; retry shortly"
          },
          "504": {
            "description": "Deadline exceeded"
          }
        },
        "security": [
          {
            "GatewaySignature": []
          }
        ],
        "summary": "Search Customers",
        "tags": [
          "customers"
        ]
      }
    },
    "/v1/customers/{customer_id}": {
      "get": {
        "description": "The Customer with the Addresses in force today.",
        "operationId": "get_customer_v1_customers__customer_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "customer_id",
            "required": true,
            "schema": {
              "title": "Customer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerProfile"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid argument"
          },
          "404": {
            "description": "No such Customer"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Database unavailable; retry shortly"
          },
          "504": {
            "description": "Deadline exceeded"
          }
        },
        "security": [
          {
            "GatewaySignature": []
          }
        ],
        "summary": "Get a Customer's profile",
        "tags": [
          "customers"
        ]
      }
    }
  }
}
