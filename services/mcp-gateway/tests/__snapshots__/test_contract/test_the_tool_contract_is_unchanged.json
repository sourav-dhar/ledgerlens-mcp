{
  "get_customer_profile": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "A Customer's profile with the Addresses in force today.\n\nMobile, email and date of birth (year only) are masked unless you hold kyc:pii.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "description": "A Customer ID: `cus_` followed by a ULID.",
          "pattern": "^cus_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        }
      },
      "required": [
        "customer_id"
      ],
      "type": "object"
    },
    "name": "get_customer_profile",
    "outputSchema": {
      "properties": {
        "addresses": {
          "items": {
            "properties": {
              "address_id": {
                "type": "string"
              },
              "address_type": {
                "enum": [
                  "permanent",
                  "correspondence"
                ],
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "district": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "is_verified": {
                "type": "boolean"
              },
              "line1": {
                "type": "string"
              },
              "line2": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pincode": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "state_code": {
                "type": "string"
              },
              "valid_from": {
                "format": "date",
                "type": "string"
              },
              "valid_to": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "address_id",
              "address_type",
              "line1",
              "line2",
              "city",
              "district",
              "state",
              "state_code",
              "pincode",
              "country",
              "is_verified",
              "valid_from",
              "valid_to"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "annual_income_band": {
          "anyOf": [
            {
              "description": "Declared annual income, in the lakh bands Indian onboarding forms use.",
              "enum": [
                "up_to_3_lakh",
                "3_to_6_lakh",
                "6_to_12_lakh",
                "12_to_25_lakh",
                "25_to_50_lakh",
                "above_50_lakh"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cif_number": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "customer_id": {
          "type": "string"
        },
        "date_of_birth": {
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "employer_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_name": {
          "type": "string"
        },
        "gender": {
          "description": "Gender as recorded on Indian KYC documents.",
          "enum": [
            "female",
            "male",
            "transgender"
          ],
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "middle_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mobile": {
          "type": "string"
        },
        "mobile_verified": {
          "type": "boolean"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "onboarding_channel": {
          "description": "Where a Customer's relationship began.",
          "enum": [
            "app",
            "web",
            "assisted",
            "partner"
          ],
          "type": "string"
        },
        "persona": {
          "description": "The behavioural archetype a Customer belongs to (see GLOSSARY: Persona).",
          "enum": [
            "salaried",
            "student",
            "gig_worker",
            "sme_owner",
            "nri",
            "senior_citizen"
          ],
          "type": "string"
        },
        "preferred_language": {
          "type": "string"
        },
        "relationship_start_date": {
          "format": "date",
          "type": "string"
        },
        "residential_status": {
          "enum": [
            "resident",
            "nri"
          ],
          "type": "string"
        },
        "risk_category": {
          "description": "KYC risk category; it sets the Re-KYC interval (see GLOSSARY: Risk category).",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "segment": {
          "description": "The commercial tier a Customer is served in (see GLOSSARY: Segment).",
          "enum": [
            "mass",
            "affluent",
            "premium"
          ],
          "type": "string"
        },
        "status": {
          "description": "A Customer's standing with the bank; Account and KYC statuses are separate lifecycles.",
          "enum": [
            "prospect",
            "active",
            "on_hold",
            "dormant",
            "frozen",
            "under_investigation",
            "deceased_claim_pending",
            "closed"
          ],
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "customer_id",
        "cif_number",
        "first_name",
        "middle_name",
        "last_name",
        "date_of_birth",
        "gender",
        "email",
        "mobile",
        "mobile_verified",
        "persona",
        "occupation",
        "employer_name",
        "annual_income_band",
        "segment",
        "residential_status",
        "preferred_language",
        "onboarding_channel",
        "relationship_start_date",
        "status",
        "risk_category",
        "created_at",
        "updated_at",
        "addresses"
      ],
      "type": "object"
    },
    "title": "Customer profile"
  },
  "get_kyc_status": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "A Customer's KYC profile in force, with its status history.\n\nPAN and Aadhaar are masked to their last four. Holders of kyc:pii may pass\nreveal_pan to see the full PAN; each reveal is recorded in the audit log.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "description": "A Customer ID: `cus_` followed by a ULID.",
          "pattern": "^cus_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        "reveal_pan": {
          "default": false,
          "description": "Return the full PAN. Needs kyc:pii; every reveal is audited.",
          "type": "boolean"
        }
      },
      "required": [
        "customer_id"
      ],
      "type": "object"
    },
    "name": "get_kyc_status",
    "outputSchema": {
      "description": "The KYC profile in force, with its status history.",
      "properties": {
        "aadhaar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Always masked: only the last four digits are stored."
        },
        "ckyc_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "customer_id": {
          "type": "string"
        },
        "events": {
          "items": {
            "properties": {
              "actor": {
                "description": "Who or what caused a status change recorded in history.",
                "enum": [
                  "system",
                  "customer",
                  "staff",
                  "npci",
                  "risk_engine"
                ],
                "type": "string"
              },
              "from_status": {
                "anyOf": [
                  {
                    "enum": [
                      "not_started",
                      "pending_documents",
                      "pending_vcip",
                      "in_review",
                      "on_hold",
                      "escalated",
                      "verified",
                      "rejected",
                      "re_kyc_due",
                      "re_kyc_overdue",
                      "expired"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "occurred_at": {
                "format": "date-time",
                "type": "string"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to_status": {
                "enum": [
                  "not_started",
                  "pending_documents",
                  "pending_vcip",
                  "in_review",
                  "on_hold",
                  "escalated",
                  "verified",
                  "rejected",
                  "re_kyc_due",
                  "re_kyc_overdue",
                  "expired"
                ],
                "type": "string"
              }
            },
            "required": [
              "from_status",
              "to_status",
              "actor",
              "reason",
              "occurred_at"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "face_match_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "fatca_crs_declared": {
          "type": "boolean"
        },
        "kyc_id": {
          "type": "string"
        },
        "kyc_status": {
          "enum": [
            "not_started",
            "pending_documents",
            "pending_vcip",
            "in_review",
            "on_hold",
            "escalated",
            "verified",
            "rejected",
            "re_kyc_due",
            "re_kyc_overdue",
            "expired"
          ],
          "type": "string"
        },
        "kyc_type": {
          "description": "How a KYC profile was verified (see GLOSSARY: Min-KYC, Full KYC, V-CIP).",
          "enum": [
            "min_kyc",
            "full_kyc",
            "v_cip",
            "ckyc_download"
          ],
          "type": "string"
        },
        "liveness_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_review_due": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ovd_type": {
          "anyOf": [
            {
              "description": "Officially Valid Documents accepted as proof of address (see GLOSSARY: OVD).",
              "enum": [
                "passport",
                "voter_id",
                "driving_licence",
                "aadhaar"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pan": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Masked to its last four; in full only when revealed with kyc:pii."
        },
        "pan_name_match_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "pan_status": {
          "anyOf": [
            {
              "enum": [
                "valid",
                "invalid",
                "not_aadhaar_linked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pep_flag": {
          "type": "boolean"
        },
        "risk_category": {
          "description": "KYC risk category; it sets the Re-KYC interval (see GLOSSARY: Risk category).",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "risk_rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sanctions_flag": {
          "type": "boolean"
        },
        "vcip_agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "vcip_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kyc_id",
        "customer_id",
        "kyc_type",
        "kyc_status",
        "ckyc_number",
        "pan_status",
        "pan_name_match_score",
        "ovd_type",
        "vcip_session_id",
        "vcip_agent_id",
        "liveness_score",
        "face_match_score",
        "pep_flag",
        "sanctions_flag",
        "fatca_crs_declared",
        "risk_category",
        "risk_rationale",
        "verified_at",
        "verified_by",
        "next_review_due",
        "created_at",
        "events"
      ],
      "type": "object"
    },
    "title": "KYC status"
  },
  "get_service_health": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Report gateway status and the circuit-breaker state of each downstream dependency.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "get_service_health",
    "outputSchema": {
      "description": "Gateway self-report returned by `get_service_health`.",
      "properties": {
        "dependencies": {
          "items": {
            "description": "State of one downstream dependency as seen by this gateway instance.",
            "properties": {
              "breaker_state": {
                "enum": [
                  "closed",
                  "open",
                  "half_open"
                ],
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "breaker_state"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "service": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "degraded"
          ],
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "service",
        "version",
        "dependencies"
      ],
      "type": "object"
    },
    "title": "Service health"
  },
  "list_kyc_documents": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Metadata of a Customer's KYC documents, newest first; never the documents.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "description": "A Customer ID: `cus_` followed by a ULID.",
          "pattern": "^cus_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        }
      },
      "required": [
        "customer_id"
      ],
      "type": "object"
    },
    "name": "list_kyc_documents",
    "outputSchema": {
      "properties": {
        "documents": {
          "items": {
            "description": "Metadata only: the document itself is never returned.",
            "properties": {
              "doc_type": {
                "enum": [
                  "pan_card",
                  "aadhaar_masked",
                  "passport",
                  "selfie",
                  "address_proof",
                  "signature"
                ],
                "type": "string"
              },
              "document_id": {
                "type": "string"
              },
              "expires_on": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kyc_id": {
                "type": "string"
              },
              "rejection_reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "accepted",
                  "rejected",
                  "expired"
                ],
                "type": "string"
              },
              "uploaded_at": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "document_id",
              "kyc_id",
              "doc_type",
              "status",
              "rejection_reason",
              "sha256",
              "uploaded_at",
              "expires_on"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "documents"
      ],
      "type": "object"
    },
    "title": "KYC documents"
  },
  "search_customers": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Find Customers matching every criterion given: name, CIF number, mobile's last four.\n\nMobile numbers are masked unless you hold kyc:pii.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "cif_number": {
          "anyOf": [
            {
              "pattern": "^\\d{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The 10-digit CIF number."
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "mobile_last4": {
          "anyOf": [
            {
              "pattern": "^\\d{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last four digits of the mobile."
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part of the first and last name."
        }
      },
      "type": "object"
    },
    "name": "search_customers",
    "outputSchema": {
      "properties": {
        "customers": {
          "items": {
            "description": "One search hit: enough to tell Customers apart and pick one.",
            "properties": {
              "cif_number": {
                "type": "string"
              },
              "customer_id": {
                "type": "string"
              },
              "full_name": {
                "type": "string"
              },
              "mobile": {
                "type": "string"
              },
              "segment": {
                "description": "The commercial tier a Customer is served in (see GLOSSARY: Segment).",
                "enum": [
                  "mass",
                  "affluent",
                  "premium"
                ],
                "type": "string"
              },
              "status": {
                "description": "A Customer's standing with the bank; Account and KYC statuses are separate lifecycles.",
                "enum": [
                  "prospect",
                  "active",
                  "on_hold",
                  "dormant",
                  "frozen",
                  "under_investigation",
                  "deceased_claim_pending",
                  "closed"
                ],
                "type": "string"
              }
            },
            "required": [
              "customer_id",
              "cif_number",
              "full_name",
              "mobile",
              "segment",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "customers"
      ],
      "type": "object"
    },
    "title": "Search customers"
  }
}
